# Usage-based billing configuration for the Pro plan.

# Compile-checked: deploying a config that breaks these fails in CI.
invariant "compute stays profitable" { margin(compute_seconds) >= 40% }

# Also compile-checked, but `else warn` softens a violation to a warning
# instead of failing the build — the incremental-adoption path when
# tightening rules on an existing config.
invariant "API price floor" { price(api_calls) >= 5 USD_CENTS else warn }

# Runtime-monitored: the bill clamps at the ceiling, and the violation
# (with its remedy) surfaces live on the dashboard.
invariant "bill shock protection" { spend(customer) <= 500 USD else cap }

# Layered above the cap: if uncapped usage runs far past the ceiling,
# `enforcement` flips to "blocked" on GET /v1/entitlements/:customer and
# the application is expected to stop serving the customer.
invariant "runaway usage hard stop" { spend(customer) <= 1000 USD else block }

# Needs events to report `_cost`: customers whose costs eat the margin
# raise an alert instead of silently losing money.
invariant "no unprofitable customers" { margin(customer) >= 20% else notify }

meter api_calls {
  filter event.name == "api.request"
  aggregate count
  unit scalar
}

meter compute_seconds {
  filter event.name == "compute.done" and event.status == "success"
  aggregate sum(event.duration_s)
  unit minutes
}

# Success-based billing as a correlated chain: one instance per ticket_id,
# steps must happen in order, and completing the chain bills one unit. A
# reopen aborts an in-flight chain — or reverses a completed one within
# 7 days, unwinding exactly that ticket's charge.
outcome ticket_resolution {
  correlate event.ticket_id
  step event.name == "ticket.opened"
  step event.name == "ticket.closed" and event.resolution == "solved"
  fail_on event.name == "ticket.reopened" within 7 days
}

product pro {
  name "Pro Plan"
  price recurring monthly 29 USD

  meter api_calls {
    per_unit 10 USD_CENTS
    included 10_000
  }

  outcome ticket_resolution { 
    per_unit 2 USD
  }
}

# A negotiated deal as config: these prices and entitlements replace the
# list versions for acme until the contract lapses. The compiler holds
# overrides to the same invariants — a deal below the API price floor
# would fail the build.
override customer "acme" {
  until "2027-01-01"
  meter api_calls {
    per_unit 8 USD_CENTS
    included 50_000
  }
  entitlement seats { limit 20 }
}
